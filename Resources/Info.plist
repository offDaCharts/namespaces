<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>en</string>
    <key>CFBundleExecutable</key><string>DeskOrbit</string>
    <!-- Preserve the original Namespaces application identity through the
         product rename so Gatekeeper, TCC permissions, and UserDefaults migrate. -->
    <key>CFBundleIdentifier</key><string>com.offdacharts.namespaces</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>DeskOrbit</string>
    <key>CFBundleDisplayName</key><string>DeskOrbit</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.3.1</string>
    <key>CFBundleVersion</key><string>19</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>DeskOrbit Commands</string>
            <key>CFBundleURLSchemes</key><array><string>deskorbit</string><string>namespaces</string></array>
        </dict>
    </array>
    <!-- Gumroad product ID for license verification. Empty = activation shows
         "not connected to a store yet"; fill in before a selling release. -->
    <key>DeskOrbitGumroadProductID</key><string></string>
    <!-- Free beta product ($0, capped quantity). Its keys work until the beta
         ends (CommercialPolicy.betaEndDate). Empty = no beta keys. -->
    <key>DeskOrbitGumroadBetaProductID</key><string></string>
    <!-- Gumroad offer link with the beta thank-you code, shown when the beta ends. -->
    <key>DeskOrbitBetaThanksURL</key><string></string>
    <!-- Feedback: email and GitHub repo the reporter can open; an optional
         HTTPS endpoint adds a one-click Send button. -->
    <key>DeskOrbitFeedbackEmail</key><string>quin+deskorbit@kauibungalow.com</string>
    <key>DeskOrbitFeedbackRepository</key><string>offDaCharts/namespaces</string>
    <key>DeskOrbitFeedbackURL</key><string></string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>LSUIElement</key><true/>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSAppleEventsUsageDescription</key><string>DeskOrbit runs only the applications, Shortcuts, and local automations you explicitly configure.</string>
    <key>NSHumanReadableCopyright</key><string>Copyright © 2026 Kauibungalow LLC. All rights reserved.</string>
</dict>
</plist>
